{
  "name": "teamsync-random-team-generator",
  "private": true,
  "type": "module",
  "version": "1.0.4",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "dev": "pnpm generate && pnpm -F app dev",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "build": "pnpm generate && pnpm -r build",
    "verify": "pnpm generate && pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check && pnpm -r build",
    "docs:check": "node scripts/check-docs.ts",
    "docs:images": "pnpm build && playwright test -c playwright.docs.config.ts --pass-with-no-tests",
    "preview": "pnpm -F app preview",
    "e2e": "playwright test",
    "e2e:miniapp": "playwright test tests/e2e/miniapp",
    "e2e:shell": "playwright test tests/e2e/shell",
    "screenshots": "pnpm build && playwright test -c playwright.screenshots.config.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.73.0",
    "prettier": "^3.10.1",
    "vitest": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "fast-check": "^4.10.3",
    "@types/node": "^24.19.0",
    "@playwright/test": "^1.65.1",
    "@axe-core/playwright": "^4.14.0",
    "marked": "^18.2.1",
    "sharp": "^0.35.4",
    "@simeonts/teamsync-random-team-generator-miniapp": "workspace:^",
    "jsdom": "^31.0.1"
  }
}
