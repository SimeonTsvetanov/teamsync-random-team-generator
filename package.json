{
  "name": "teamsync-random-team-generator",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "dev": "pnpm generate && pnpm -F app dev",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "pnpm generate && pnpm -r build",
    "verify": "pnpm generate && pnpm lint && pnpm typecheck && pnpm test && pnpm -r build",
    "preview": "pnpm -F app preview",
    "e2e": "playwright test",
    "screenshots": "pnpm build && playwright test -c playwright.screenshots.config.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.72.0",
    "prettier": "^3.9.0",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.0",
    "@types/node": "^24.19.0",
    "@playwright/test": "^1.64.0",
    "@axe-core/playwright": "^4.14.0",
    "marked": "^18.0.0",
    "sharp": "^0.35.4"
  }
}
