{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "../.tsbuild/app",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "rootDir": ".."
  },
  "include": [
    "src",
    "src/generated/*.json",
    "vite.config.ts",
    "pwa-assets.config.ts",
    "../app.config.ts",
    "../scripts/seo.ts"
  ],
  "references": [
    {
      "path": "../packages/core"
    }
  ]
}
